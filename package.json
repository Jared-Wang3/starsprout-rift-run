{
  "name": "starsprout-rift-run",
  "version": "3.0.0",
  "private": true,
  "description": "纸雕风横版闯关游戏《星芽跃界》的在线版与 Windows 桌面版",
  "main": "electron/main.cjs",
  "author": "Star Sprout Studio",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop": "electron .",
    "dist:desktop": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:windows": "electron-builder --win portable nsis",
    "test": "npm run build && node --test tests/game-data.test.mjs tests/game-ui.test.mjs tests/game-art.test.mjs tests/gameplay-feedback.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fs-extra": "11.3.6",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.starsprout.riftrun",
    "productName": "星芽跃界",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/main.cjs",
      "public/play/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "星芽跃界-${version}-便携版.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "星芽跃界-${version}-安装包.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星芽跃界"
    }
  }
}
